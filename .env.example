# 雲端三段式對話 pipeline 的金鑰設定（src/agent_system/cloud_voice_chat.py）
# 複製成 .env 後填入自己的金鑰。.env 已被 .gitignore 忽略，不會進版控。

# --- LLM：二選一 ---------------------------------------------------------
# provider=openai 時必填
OPENAI_API_KEY=sk-...

# provider=gemini 時必填（https://aistudio.google.com/apikey 免費取得）
GEMINI_API_KEY=

# --- 選填 ----------------------------------------------------------------
# 指向 OpenAI 相容服務。留空則用官方 https://api.openai.com/v1
# 例：Groq（便宜且延遲低）https://api.groq.com/openai/v1
OPENAI_BASE_URL=

# 註：TTS 走 edge-tts（微軟 Edge 的免費語音服務），不需要任何金鑰。
